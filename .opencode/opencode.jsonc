{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["vpx", "chrome-devtools-mcp@latest"],
        "disabled": false,
      },
      "drizzle": {
        "type": "local",
        "command": ["vpx", "drizzle-kit", "mcp"],
        "cwd": "/Volumes/samsung/dev/internmo/medicore/packages/db",
        "disabled": false,
      },
      "better-auth": {
        "type": "remote",
        "url": "https://mcp.better-auth.com/mcp",
        "disabled": false,
      },
    },
  },
}
