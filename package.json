{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 5173",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 4173",
    "clean": "nuxt cleanup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "vp hooks enable",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/lucide": "1.2.157",
    "@iconify-json/simple-icons": "1.2.103",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/icon": "2.6.3",
    "@nuxt/ui": "4.13.0",
    "nuxt": "4.6.4",
    "tailwindcss": "4.3.5",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite-plus": "1.7.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
