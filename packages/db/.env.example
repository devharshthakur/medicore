# Local development only. Do not reuse these credentials in production.
# Local PostgreSQL started by compose.yaml.
POSTGRES_USER=medcore
POSTGRES_PASSWORD=medcore
POSTGRES_DB=medcore
POSTGRES_PORT=5432

# Used by Drizzle Kit and @medcore/db. Keep the user, password, database, and port in sync with the values above.
DATABASE_URL=postgres://medcore:medcore@localhost:5432/medcore
