# Copy this file to .env and fill in the values. Never commit .env.
#   cp -n .env.example .env
#
# One file for the whole repository: the API and web launchers, Drizzle Kit,
# the local PostgreSQL and the Docker stack (both in compose.yaml).
# Variables already set in the shell take precedence over this file.
#
# scripts/env/ validates these values before the root dev, build, preview,
# docker:up, and db:* scripts run. Invalid values stop everything with an error.
# Rules: ports are 1-65535, URLs are http(s) (postgres:// for DATABASE_URL),
# BETTER_AUTH_SECRET is at least 32 characters, and POSTGRES_PASSWORD is at least
# 16 characters because the Docker stack rejects shorter values.
#
# The defaults below are for local development only. Before running the Docker
# stack, change POSTGRES_PASSWORD and BETTER_AUTH_SECRET, and set BETTER_AUTH_URL
# and WEB_PORT as described in docs/docker.md.

# ---------------------------------------------------------------------------
# Ports (local development and preview)
# ---------------------------------------------------------------------------

# Nuxt development server. Default: 5173
WEB_DEV_PORT=5173

# Nuxt preview server. Default: 4173
WEB_PREVIEW_PORT=4173

# API server for dev, preview, and start. Default: 8000
API_PORT=8000

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------

# Where the web server forwards /api/** requests (read as runtime config apiOrigin).
# Must be an http or https URL. Default: http://localhost:8000
NUXT_API_ORIGIN=http://localhost:8000

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------

# Public origin of the web app, as the browser sees it: cookies, callbacks,
# and origin checks all use it.
#   Local development: http://localhost:5173
#   Docker stack:      http://localhost:3000 (must match WEB_PORT)
BETTER_AUTH_URL=http://localhost:5173

# Secret for signing and encrypting Better Auth data. Generate one with
# `openssl rand -base64 32` (local) or `openssl rand -hex 32` (Docker).
# Keep it stable: changing it invalidates existing sessions.
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Used by local development and the Docker stack (compose.yaml), which creates
# its database with these values. Replace the
# placeholder password with `openssl rand -hex 32` before any shared or production
# use; the value is embedded in DATABASE_URL, so use hexadecimal output.
POSTGRES_USER=medcore
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_DB=medcore-db

# Host port for the PostgreSQL service in compose.yaml (bound to 127.0.0.1).
POSTGRES_PORT=5432

# Used by Drizzle Kit and the API. Keep the user, password, database, and port
# in sync with the values above.
DATABASE_URL=postgres://medcore:change-this-development-password@127.0.0.1:5432/medcore-db

# ---------------------------------------------------------------------------
# Docker Compose stack (compose.yaml)
# ---------------------------------------------------------------------------

# Host port that the web app is published on, bound to 127.0.0.1. Default: 3000
WEB_PORT=3000
