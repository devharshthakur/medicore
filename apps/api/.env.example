# API port for dev, preview, and start. Default: 8000
API_PORT=8000

# PostgreSQL for @medcore/db. Start it with `docker compose -f packages/db/compose.yaml up -d`.
DATABASE_URL=postgres://medcore:medcore@localhost:5432/medcore

# Public origin of the web app. It proxies /api/** to this API, so Better Auth uses the web origin
# for cookies, callbacks, and origin checks. Default: http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173

# Secret used to sign and encrypt Better Auth data. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
