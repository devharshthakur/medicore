{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["WEB_DEV_PORT", "API_PORT"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": ["WEB_PREVIEW_PORT", "API_PORT"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "typecheck": {},
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/prettier.config.js", "prettier.config.js", ".prettierignore"]
    }
  }
}
